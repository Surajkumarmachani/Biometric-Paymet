# ============================================================================
# Copy to .env.local. Never commit real values.
#
# Only RAZORPAY_KEY_ID and the Clerk publishable key are safe in the browser.
# Everything else is server-only and must never be prefixed NEXT_PUBLIC_.
# ============================================================================

# --- Database (server only) ---------------------------------------------------
# Supabase → Project Settings → Database → Connection string (use the pooler
# for serverless: port 6543, ?pgbouncer=true).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/regal_test

# --- Supabase (client reads + Realtime) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. If this ever appears in a client bundle, rotate it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Razorpay ----------------------------------------------------------------
# rzp_test_... in test mode, rzp_live_... in production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Signs the browser callback (order_id|payment_id).
RAZORPAY_KEY_SECRET=
# DIFFERENT secret, set when you create the webhook in the Dashboard.
# Signs the raw webhook body. Rotating this needs dual-secret verification —
# set RAZORPAY_WEBHOOK_SECRET_PREVIOUS during the overlap window.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# --- WebAuthn — DORMANT (Option B, Sprint 6) ---------------------------------
# NOTHING READS THESE TODAY. Clerk owns the WebAuthn ceremony, so we never
# verify an assertion and never need our own rp.id or origin allowlist. Leave
# them unset; they become live only if an own-credential ceremony is built.
# See the "Dormant by design" table in README.md.
#
# APEX domain, decided ONCE. Changing it destroys every existing credential.
WEBAUTHN_RP_ID=regallab.example
WEBAUTHN_RP_NAME=REGAL LAB
# Every origin, comma-separated. A missing entry is the classic
# "works on desktop, fails on the QR flow" bug.
WEBAUTHN_ALLOWED_ORIGINS=https://regallab.example,https://www.regallab.example,https://pay.regallab.example

# --- OTP delivery (S2 identity fallback) -------------------------------------
# The OTP code is routed by identifier: an email address -> Resend, a phone
# number (E.164, e.g. +919693260085) -> Twilio SMS. Leave a section blank to
# fall back to the dev server log for that channel.
#
# Email — Resend (https://resend.com → API Keys). OTP_EMAIL_FROM must be a
# verified sender; use onboarding@resend.dev while testing before domain setup.
RESEND_API_KEY=
OTP_EMAIL_FROM=REGAL LAB <onboarding@resend.dev>
# SMS — Twilio (Console → Account SID / Auth Token, and a From number or
# messaging-service SID). Indian numbers need DLT registration for production;
# a Twilio trial can send only to verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_ORIGIN=https://regallab.example
# Merchant category code. '5944' (jewellery) => ₹2,00,000 UPI per-txn ceiling.
# CONFIRM YOUR ACTUAL MCC AND ENABLED LIMIT WITH YOUR ACQUIRER IN WRITING.
MERCHANT_MCC=5944
# Shared secret for the cron-driven drain and reconciler routes.
INTERNAL_TASK_SECRET=

# --- Risk layer (S5) ---------------------------------------------------------
# Hard per-order ceiling in PAISE. Orders above this are refused. Default
# 20000000 (₹2,00,000). Orders at/above RISK_REVIEW_PAISE (default 80% of the
# cap) are allowed but flagged high-value for review.
RISK_MAX_ORDER_PAISE=20000000
RISK_REVIEW_PAISE=

# --- GST invoicing (S5) ------------------------------------------------------
# Your registered seller identity. GST_RATE_BPS is basis points (300 = 3%, the
# gold-jewellery rate). Correctness of rate/HSN/state is your CA's call.
GST_SELLER_GSTIN=
GST_SELLER_LEGAL_NAME=REGAL LAB
GST_SELLER_ADDRESS=
GST_SELLER_STATE_CODE=
GST_RATE_BPS=300
GST_DEFAULT_HSN=7113

# --- Alerts (S5) -------------------------------------------------------------
# Slack-compatible incoming webhook. If set, alertOn() pushes criticals here
# (late auth, dead webhook, OTP global ceiling, high-value orders). Runbooks:
# docs/runbooks.md. Leave blank to log-only.
ALERT_WEBHOOK_URL=
